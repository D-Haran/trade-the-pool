{
  "name": "trade-the-pool",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "db:migrate": "pnpm --filter @trade-the-pool/database db:migrate",
    "db:seed": "pnpm --filter @trade-the-pool/database db:seed",
    "simulate": "pnpm --filter @trade-the-pool/simulator simulate --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @trade-the-pool/trading-engine test:integration && pnpm --filter @trade-the-pool/api test:integration",
    "test:e2e": "pnpm --filter @trade-the-pool/web test:e2e",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.23",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
